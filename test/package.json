{
  "name": "finally-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright E2E test suite for the FinAlly AI Trading Workstation",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:docker": "docker-compose -f docker-compose.test.yml up --build --exit-code-from playwright --abort-on-container-exit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0"
  }
}
